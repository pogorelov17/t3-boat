#!/usr/bin/env python3
"""Run and provision the persistent T3 coordinator."""
import argparse
import fcntl
import hashlib
from datetime import datetime, timezone
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path


sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
import boat_profile
import playbook
from boat_profile import PARENT, read_profile, read_state, write
from model_picker import configure

# The provider subscriptions of each profile, with the names used for sign-in and Boat subscriptions.
PROFILES = {name: tuple("claude" if p == "claudeAgent" else p for p in providers)
            for name, providers in boat_profile.PROVIDERS.items()}
SUBSCRIPTIONS = {"codex": "chatgpt-subscription", "claude": "claude-subscription"}
BOAT_ENV = "https://boat.dev/dashboard?tab=environment"
BOAT_AI = "https://boat.dev/dashboard?tab=agents"
LOCAL_URL = "http://127.0.0.1:3773"


class SetupError(Exception):
    pass


class ProfileError(SetupError):
    """A saved profile the user must repair; the message names the file."""


def probe(*argv):
    """Never echo raw metadata: Boat environments can include secret values."""
    try:
        result = subprocess.run(argv, capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=25)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode == 0:
        return (result.stdout + result.stderr).strip()
    return None


def boat_records(command, key):
    try:
        result = subprocess.run(["boat", *command, "--json"], capture_output=True, text=True,
                                stdin=subprocess.DEVNULL, check=True, timeout=25)
        rows = json.loads(result.stdout)[key]
        if isinstance(rows, list) and all(isinstance(row, dict) for row in rows):
            return rows
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError):
        pass
    raise SetupError(f"Cannot read Boat {key}. Check boat login, network and account permissions.")


def logged_in(provider):
    if provider == "codex":
        return "logged in using chatgpt" in (probe("codex", "login", "status") or "").lower()
    try:
        auth = json.loads(probe("claude", "auth", "status") or "{}")
        return (auth.get("loggedIn") is True and auth.get("apiProvider") == "firstParty"
                and auth.get("authMethod") in ("claude.ai", "oauth_token"))
    except (ValueError, AttributeError):
        return False


def run(*argv):
    try:
        subprocess.run(argv, check=True)
    except (OSError, subprocess.CalledProcessError):
        raise SetupError(f"{argv[0]} command failed. Fix the reported issue and rerun setup.") from None


def repo_slug(value):
    pattern = r"(?:https://github\.com/|git@github\.com:)([a-z0-9][a-z0-9-]*)/([a-z0-9_.-]+?)(?:\.git)?/?"
    match = re.fullmatch(pattern, value, re.IGNORECASE | re.ASCII)
    if not match or match[2].lower() in (".", "..", ".git"):
        raise SetupError("Enter a GitHub repository URL without credentials, query parameters or a branch.")
    return "/".join(match.groups())


def t3_online():
    try:
        with urllib.request.urlopen(LOCAL_URL + "/.well-known/t3/environment", timeout=3) as response:
            return bool(json.load(response).get("environmentId"))
    except (OSError, ValueError, AttributeError):
        return False


def env_for(environments, label):
    matches = [env for env in environments if label and label in (env.get("name"), env.get("id"))]
    if len(matches) != 1:
        raise SetupError(f"Choose one accessible Boat environment at {BOAT_ENV}.")
    return matches[0]


def check_access(env, profiles, providers):
    if (env.get("safeForThirdParties") is not False or env.get("passGithub") is not True
            or env.get("passAgentsCredentials") is not True):
        raise SetupError(f"Choose an environment for your private workers with GitHub and agent credentials enabled at {BOAT_ENV}.")
    selected = env.get("credentialProfileId")
    if selected:
        matches = [p for p in profiles if selected in (p.get("id"), p.get("name"))]
    else:
        matches = [p for p in profiles if p.get("isDefault") is True]
    if len(matches) != 1:
        raise SetupError(f"Set an explicit, accessible AI credential profile on this environment at {BOAT_ENV}.")
    missing = [SUBSCRIPTIONS[p] for p in providers if SUBSCRIPTIONS[p] not in matches[0].get("connected", [])]
    if missing:
        raise SetupError(f"Connect {', '.join(missing)} in the environment's AI profile at {BOAT_AI}.")

    return matches[0].get("id") or matches[0].get("name")


def has_repo(env, slug):
    return any(str(r.get("fullName", "")).lower() == slug.lower()
               for r in env.get("selectedRepositories", []) if isinstance(r, dict))


def projects():
    bound = sorted((Path.home() / "projects").glob("*/*/.git"))
    starter = Path.home() / "start-here"
    if (starter / ".git").is_dir() and probe("git", "-C", str(starter), "config", "--local", "--get", "boat.environment"):
        bound.append(starter / ".git")
    return bound


def add_workspace(workspace, title):
    result = subprocess.run(["t3", "project", "add", "--title", title, str(workspace)],
                            capture_output=True, text=True)
    if result.returncode and "An active project already exists for" not in result.stdout + result.stderr:
        raise SetupError("T3 could not register the workspace. Check that the server is running and retry setup.")


def register(slug, label):
    # Concurrent setup sessions can both try to claim the first chat.
    with (Path.home() / ".t3-boat-register.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        bind_project(slug, label)


def bind_project(slug, label):
    workspace = Path.home() / "projects" / slug
    origin = "https://github.com/" + slug + ".git"
    starter = Path.home() / "start-here"
    if starter.is_dir() and not workspace.exists():
        attached = probe("git", "config", "--file", str(starter / ".git/config"), "--get", "remote.origin.url")
        if not attached or attached.lower() == origin.lower():
            workspace = starter
    if workspace.exists():
        current = probe("git", "-C", str(workspace), "config", "--local", "--get", "remote.origin.url")
        if (workspace != starter and not (workspace / ".git").is_dir()) or (current and current.lower() != origin.lower()):
            raise SetupError(f"Existing directory {workspace} belongs to another project.")
    workspace.mkdir(parents=True, exist_ok=True)
    git = ["git", "-C", str(workspace)]
    run(*git, "init", "--quiet")
    run(*git, "config", "--local", "protocol.allow", "never")
    run(*git, "config", "--local", "remote.origin.url", origin)
    run(*git, "config", "--local", "boat.environment", label)
    add_workspace(workspace, "Start here" if workspace == starter else slug.rsplit("/", 1)[1])
    print(f"Registered {slug} in T3 at {workspace}.")


def parent_role(profile):
    try:
        return read_profile(profile)[0][PARENT]
    except (boat_profile.ProfileError, playbook.PlaybookError) as error:  # The message names the file.
        raise ProfileError(str(error)) from None


def receipt_path(profile, slug):
    key = hashlib.sha256((slug or "").lower().encode()).hexdigest()
    return Path.home() / ".boat-checks" / profile / key


def read_receipt(profile, slug):
    try:
        record = json.loads(receipt_path(profile, slug).read_text())
        return record if isinstance(record, dict) else {}
    except (OSError, ValueError):
        return {}


def check_signature(profile, env, credential):
    """What a VM check covered: the lead model it probed and the environment, or None for a profile that cannot
    be applied, which no check covers. The attached playbook does not change what the check covers."""
    try:
        config = [read_profile(profile)[0][PARENT], env["id"], env.get("version"), credential]
    except (boat_profile.ProfileError, playbook.PlaybookError):
        return None
    return hashlib.sha256(json.dumps(config, sort_keys=True).encode()).hexdigest()


def project_binding(git_dir):
    git = ["git", "-C", str(git_dir.parent), "config", "--local", "--get"]
    return repo_slug(probe(*git, "remote.origin.url") or ""), probe(*git, "boat.environment")


def describe(attachment):
    if attachment is None:
        return "none (the team lead briefs every worker itself)"
    try:
        package = playbook.load(attachment["path"])
    except playbook.PlaybookError as error:
        return f"cannot be read: {error}"
    return (package.label() + (f", model set {attachment['model_set']}" if attachment["model_set"] else ", no model set")
            + (f", team lead follows {attachment['lead_role']}" if attachment["lead_role"] else ", no role for the team lead"))


def menu_choice(reply, names):
    """Displayed numbers select by position, including when a package uses numeric names."""
    for position, name in enumerate(names, start=1):
        if reply == str(position):
            return name
    return reply if reply in names else None


def choose_lead_role(package, current):
    """Ask which of the package's roles the T3 team lead follows, if any. Only an earlier choice is a default:
    no role name means anything to T3 Boat."""
    roles = list(package.roles)
    default = current if current in roles else None
    print(f"Roles of {package.name}: " + ", ".join(f"{n}. {role}" for n, role in enumerate(roles, start=1)))
    while True:
        reply = input("Role the T3 team lead follows ('none' for no role)"
                      + (f" [{default}]: " if default else ": ")).strip()
        if not reply and default:
            return default
        if reply.lower() == "none":
            return None
        chosen = menu_choice(reply, roles)
        if chosen:
            return chosen
        print("Select a listed role by number or name, or 'none'.")


def choose_model_set(profile, package, current):
    """Ask which of the package's model sets assigns this profile's models, or None ('none', or none fits).
    Only an earlier choice is a default: no set name means anything to T3 Boat."""
    if not package.model_set_paths:
        print(f"{package.name} declares no model sets; the team lead chooses each worker's model.")
        return None
    fitting = package.fitting_sets(boat_profile.PROVIDERS[profile])
    other = [name for name in package.model_set_paths if name not in fitting]
    if other:
        print(f"Model sets that need a provider {profile} does not enable: {', '.join(other)}.")
    if not fitting:
        print(f"No model set of {package.name} fits {profile}; the team lead chooses each worker's model.")
        return None
    default = current if current in fitting else None
    print(f"Model sets of {package.name} for {profile}:")
    for number, name in enumerate(fitting, start=1):
        print(f"  {number}. {name}")
    while True:
        reply = input("Model set ('none' to let the team lead choose each worker's model)"
                      + (f" [{default}]: " if default else ": ")).strip()
        if reply.lower() == "none":
            return None
        chosen = default if not reply else menu_choice(reply, fitting)
        if chosen:
            return chosen
        print("Select a listed model set by number or name, or 'none'.")


def choose_playbook(profile, current):
    """Ask whether to attach an external playbook package. Returns the attachment to save, or None.

    Nothing is saved here: the attachment is saved with the lead model, once the owner accepts it.
    """
    bundled = None
    try:
        bundled = playbook.load(str(playbook.BUNDLED))
    except playbook.PlaybookError:
        pass
    print("A playbook is an optional external package of role guides and model sets (a team.json manifest). "
          "Attached, it decides the team's roles, their instructions, counts and models; without one the team lead "
          "briefs every worker itself. It applies to every project of this profile; nothing is added to your "
          "repositories.")
    print(f"Current playbook: {describe(current)}")
    choices = "Enter to keep it, 'none' to detach" if current else "Enter for none"
    if bundled:
        choices += f", 'bundled' for {bundled.label()}"
    choices += ", or the absolute path of a package directory in the container (for example under /data/teams)"
    print(choices + ".")
    while True:
        reply = input("Playbook: ").strip()
        if not reply:
            if current is None:
                return None
            path = current["path"]
        elif reply.lower() == "none":
            return None
        elif reply.lower() == "bundled" and bundled:
            path = str(bundled.root)
        else:
            path = reply
        try:
            package = playbook.load(path)
        except playbook.PlaybookError as error:
            print(f"{error}. Enter another path, or 'none'.")
            continue
        print(f"Attaching {package.label()}: roles " + ", ".join(
            f"{role} ({spec['instances']})" for role, spec in package.roles.items()) + ".")
        same = current is not None and Path(current["path"]) == package.root
        lead_role = choose_lead_role(package, current["lead_role"] if same else None)
        model_set = choose_model_set(profile, package, current["model_set"] if same else None)
        return {"path": str(package.root), "model_set": model_set, "lead_role": lead_role}


def setup(profile, providers):
    if not t3_online():
        raise SetupError("T3 is starting or unreachable. Check docker logs t3-boat and retry setup.")
    # Name an unreadable saved profile before installing anything or asking for a sign-in. An attached package
    # that cannot be read is not an error here: setup asks for the playbook again.
    try:
        state = read_state(profile, missing=None)
    except boat_profile.ProfileError as error:
        raise ProfileError(str(error)) from None
    for provider in providers:
        if provider == "claude":
            run("install-claude")
        if not logged_in(provider):
            print(f"Sign in to {provider} on this T3 server.", flush=True)
            if provider == "codex":
                run("codex", "login", "--device-auth")
            else:
                run("claude", "auth", "login")
            if not logged_in(provider):
                raise SetupError(f"A {provider} subscription login is required. Rerun setup to resume.")
    attachment = choose_playbook(profile, state and state.get("playbook"))
    configure(profile, attachment)
    existing = projects()
    optional = " (Enter to resume existing projects)" if existing else " (Enter to start with an idea)"
    url = input(f"GitHub repository URL{optional}: ").strip()
    if probe("boat", "status", "--check") is None:
        run("boat", "onboard", "--wait")
        if probe("boat", "status", "--check") is None:
            raise SetupError("Boat login is incomplete. Rerun setup after approving the device.")
    print("In Boat, connect the GitHub App. For a repository, grant Contents and Pull requests write access.")
    print("Under Agents & Proxying, connect " + ", ".join(SUBSCRIPTIONS[p] for p in providers)
          + " in the credential profile your worker environment uses.")
    print(f"GitHub and environment: {BOAT_ENV}\nWorker subscriptions: {BOAT_AI}")
    envs = boat_records(["env", "list"], "environments")
    if url or not existing:
        slug = repo_slug(url) if url else None
        print("Boat environments:", ", ".join(e["name"] for e in envs))
        default = envs[0]["name"] if len(envs) == 1 else ""
        label = input(f"Boat environment name or ID [{default}]: ").strip() or default
        env = env_for(envs, label)
        selected = [(slug, env["name"])]
    else:
        selected = [project_binding(git_dir) for git_dir in existing]
    profiles = boat_records(["ai", "profiles"], "profiles")
    for slug, label in selected:
        env = env_for(envs, label)
        path = receipt_path(profile, slug)
        path.unlink(missing_ok=True)
        credential = check_access(env, profiles, providers)
        if slug and not has_repo(env, slug):
            if input(f"Attach {slug} to Boat environment {env['name']}? [y/N] ").strip().lower() != "y":
                raise SetupError("Project setup paused. Rerun setup once the repository is attached.")
            run("boat", "env", "add-repo", env["name"], slug)
            envs = boat_records(["env", "list"], "environments")
            env = env_for(envs, env["id"])
            if not has_repo(env, slug):
                raise SetupError("Repository attachment is still unconfirmed. Check Boat and rerun setup.")
            credential = check_access(env, profiles, providers)
        print("Starting a disposable small Boat VM for a live subscription and GitHub check.", flush=True)
        run("boat-worker", "verify", env["name"], *([slug] if slug else []))
        if slug:
            register(slug, env["name"])
        else:
            starter = Path.home() / "start-here"
            starter.mkdir(exist_ok=True)
            add_workspace(starter, "Start here")
        record = {"environment": env["id"], "signature": check_signature(profile, env, credential),
                  "checked": datetime.now(timezone.utc).isoformat(timespec="seconds")}
        write(path, json.dumps(record))
    print("For a fresh pairing link through your SSH tunnel, run on the VPS:")
    print("docker exec -it t3-boat t3 auth pairing create --ttl 5m --base-url " + LOCAL_URL)


def status(profile, providers):
    failures = []

    def report(label, ready):
        print(f"[{'ok' if ready else 'missing'}] {label}")
        if not ready:
            failures.append(label)

    report("T3 HTTP server", t3_online())
    problem = None
    try:
        state = read_state(profile, missing=None)
        print("Playbook: " + describe(state and state.get("playbook")))
        lead = parent_role(profile)
        t3_home = Path(os.environ.get("T3CODE_HOME") or Path.home() / ".t3")
        settings = json.loads((t3_home / "userdata/settings.json").read_text())
        selection = settings.get("defaultModelSelection", {})
        expected = {("claudeAgent" if p == "claude" else p) for p in providers}
        instances = settings.get("providerInstances", {})
        option = "effort" if lead["provider"] == "claudeAgent" else "reasoningEffort"
        active = (selection.get("instanceId") == lead["provider"]
                  and selection.get("model") == lead["model"]
                  and {"id": option, "value": lead["effort"]} in selection.get("options", [])
                  and all(instances.get(p, {}).get("enabled") is (p in expected) for p in ("codex", "claudeAgent"))
                  and settings.get("linkedEnvironmentsEnabled") is True
                  and boat_profile.applied(profile))
    except (ProfileError, boat_profile.ProfileError, playbook.PlaybookError) as error:
        active, problem = False, error
    except (OSError, ValueError, KeyError, TypeError, SetupError):
        active = False
    report(f"Global profile {profile} applied", active)
    if problem:
        print(f"  {problem}")
    for provider in providers:
        report(f"Local {provider} subscription login", logged_in(provider))
    registered = projects()
    if not registered:
        starter = Path.home() / "start-here"
        report("Start here workspace", starter.is_dir() and
               probe("t3", "thread", "list", "--project", str(starter), "--json") is not None)
        print("Repository access deferred until you supply a GitHub URL.")
    boat = probe("boat", "status", "--check") is not None
    report("Boat account", boat)
    if boat:
        envs = boat_records(["env", "list"], "environments")
        profiles = boat_records(["ai", "profiles"], "profiles")
        targets = [project_binding(g) for g in registered] or [(None, read_receipt(profile, None).get("environment"))]
        for slug, label in targets:
            try:
                env = env_for(envs, label)
                credential = check_access(env, profiles, providers)
                record = read_receipt(profile, slug)
                signature = check_signature(profile, env, credential)
                report(f"{env['name']}: last successful VM check for {slug or profile} "
                       f"({record.get('checked', 'never')})",
                       signature is not None and record.get("signature") == signature)
                if slug:
                    report(f"{slug} attached to {env['name']}", has_repo(env, slug))
            except SetupError as error:
                report(str(error), False)
        for git_dir in registered:
            report(f"T3 project {git_dir.parent}", probe("t3", "thread", "list", "--project",
                                                        str(git_dir.parent), "--json") is not None)
    if failures:
        print("Next: docker exec -it t3-boat t3-boat setup")
        return 1
    print("Setup verified. Repository write access is first used when a worker delivers a change.")
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("serve", "setup", "status"))
    args = parser.parse_args()
    profile = os.environ.get("T3_BOAT_PROFILE", "")
    if profile not in PROFILES:
        parser.error("set T3_BOAT_PROFILE to " + ", ".join(PROFILES))
    if args.command == "serve":
        result = subprocess.run([sys.executable, str(Path(__file__).resolve().parents[1] / "lib/boat_profile.py"), profile],
                                stderr=subprocess.PIPE, text=True)
        if result.returncode:
            *earlier, detail = result.stderr.rstrip("\n").split("\n")
            if detail.startswith("T3 Boat profile:"):
                sys.stderr.write("".join(line + "\n" for line in earlier))
                sys.exit(f"{detail.rstrip('.')}. Next: repair the named file in the t3-boat-data volume, then restart the container.")
            sys.stderr.write(result.stderr)
            sys.exit(result.returncode)
        sys.stderr.write(result.stderr)
        # Where the README copies an owner's own playbook package: `docker cp` needs the parent directory.
        (Path.home() / "teams").mkdir(exist_ok=True)
        os.chdir(Path.home())
        os.execvp("t3", ["t3", "--no-browser", "--host", "0.0.0.0", "--port", "3773"])
    if args.command == "setup":
        with (Path.home() / ".boat-setup.lock").open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            setup(profile, PROFILES[profile])
    return status(profile, PROFILES[profile])


if __name__ == "__main__":
    os.umask(0o077)
    try:
        sys.exit(main())
    except (ProfileError, boat_profile.ProfileError) as error:
        # The message names the file to repair; rerunning setup first would fail the same way.
        sys.exit(f"T3 Boat profile: {error}")
    except (SetupError, ValueError, EOFError, OSError, KeyboardInterrupt) as error:
        sys.exit(f"{error or 'Setup interrupted.'}\nNext: docker exec -it t3-boat t3-boat setup")
