#!/usr/bin/env python3
"""Provision and link one private Boat VM for one T3 child."""
import json
import os
import re
import shlex
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
import uuid
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
import playbook_skills
from boat_profile import PARENT, PROVIDERS, OPTION, read_profile, state_lock


def output(*args):
    return subprocess.check_output(args, text=True).strip()


def subscription_check(provider):
    if provider == "codex":
        return """
command -v codex >/dev/null
codex login status 2>&1 | grep -Fqi 'logged in using chatgpt' || {
  echo 'Boat did not supply a ChatGPT subscription login' >&2; exit 1;
}
"""
    return """
if ! command -v claude >/dev/null 2>&1; then
  curl -fsSL https://claude.ai/install.sh -o "$HOME/t3-worker/claude-install.sh"
  bash "$HOME/t3-worker/claude-install.sh" 2.1.330 >&2
fi
version=$(claude --version | awk '{print $1}')
test -n "$version" && test "$(printf '%s\\n' 2.1.321 "$version" | sort -V | head -1)" = 2.1.321 || {
  echo 'Boat Claude Code must be at least 2.1.321' >&2; exit 1;
}
claude auth status 2>/dev/null | python3 -c 'import json,sys; s=json.load(sys.stdin); sys.exit(0 if s.get("loggedIn") and s.get("apiProvider")=="firstParty" and s.get("authMethod")=="oauth_token" else 1)' || {
  echo 'Boat did not supply a Claude subscription token' >&2; exit 1;
}
"""


# Instructions for a worker started without a playbook role: the lead's brief decides its job.
WORKER_NOTE = """You are a worker on a disposable Boat VM, started by the T3 team lead. Your brief from the lead is your task; it decides what you do and what you deliver.

- Do all source inspection, edits, project commands, tests, dependency installs, builds and clones here on this VM. If the brief names a repository, verify that a local checkout's origin matches it before using it, or clone it here.
- Put code changes on a task branch and open a draft pull request through the project's authorized GitHub integration. Never push to the target branch.
- You may split your work further only when the brief allows it and your tools support it. Name in your result what you handed on, to whom, and what came back.
- End with a compact result for the lead: what you did, the commands you ran with pass or fail, the branch, exact commit SHA and pull request URL when there are any, open questions, and what is unverified. Report only what you observed. Link to details instead of pasting long logs.
- Keep credentials, tokens and account details out of your result."""


def worker_instructions(provider, guide):
    """Append the worker's instructions (a playbook role guide or WORKER_NOTE) to its provider's global instruction file.

    Codex reads a non-empty AGENTS.override.md instead of AGENTS.md. When the Boat environment provides one,
    the instructions are appended to that file, after the owner's own text, so Codex reads both.
    """
    if guide is None:
        return ""
    end = "<!-- END t3-boat -->"
    block = f"<!-- BEGIN t3-boat -->\n{guide.rstrip()}\n{end}"
    if provider == "codex":
        target = '"${CODEX_HOME:-$HOME/.codex}/AGENTS.md"'
        masked = """override="${CODEX_HOME:-$HOME/.codex}/AGENTS.override.md"
if [ -f "$override" ] && [ -s "$override" ]; then
  guide=$override
  echo "Codex reads $override on this VM; the t3-boat worker instructions are appended to it" >&2
fi"""
    else:
        target, masked = '"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/CLAUDE.md"', ""
    return f"""
guide={target}
{masked}
mkdir -p "$(dirname "$guide")"
if [ -s "$guide" ]; then printf '\\n\\n' >> "$guide"; fi
printf '%s\\n' {shlex.quote(block)} >> "$guide"
[ "$(tail -n 1 "$guide")" = {shlex.quote(end)} ] || {{ echo "The t3-boat worker instructions were not written to $guide" >&2; exit 1; }}
"""


def bootstrap(lead, guide, providers):
    """The VM setup script: T3 opens with the lead model and enables every provider in `providers`."""
    provider = lead["provider"]
    providers = tuple(providers)
    settings = {
        "linkedEnvironmentsEnabled": True,
        "defaultModelSelection": {
            "instanceId": provider, "model": lead["model"],
            "options": [{"id": OPTION[provider], "value": lead["effort"]}],
        },
        "providerInstances": {p: {"driver": p, "enabled": p in providers} for p in OPTION},
    }
    checks = "".join(subscription_check("claude" if p == "claudeAgent" else p) for p in OPTION if p in providers)
    return f"""
set -eu
umask 077
export PATH="$HOME/.local/bin:$PATH"
test ! -e "$HOME/.t3/userdata/settings.json"
mkdir -p "$HOME/.t3/userdata" "$HOME/t3-worker"
printf '%s\\n' {shlex.quote(json.dumps(settings))} > "$HOME/.t3/userdata/settings.json"
cd "$HOME/t3-worker"
{checks}
{"".join(worker_instructions(p, guide) for p in OPTION if p in providers)}
npm install --prefix "$HOME/t3-worker-runtime" t3@0.1.11 >&2
nohup "$HOME/t3-worker-runtime/node_modules/.bin/t3" --no-browser --host 127.0.0.1 --port 3773 --auto-bootstrap-project-from-cwd >"$HOME/t3-worker.log" 2>&1 </dev/null &
"""


def link(vm, lead, guide, providers):
    def remote(command):
        return output("boat", "ssh", vm, command)

    try:
        remote("sh -c " + shlex.quote(bootstrap(lead, guide, providers)))
    except subprocess.CalledProcessError as error:  # The command holds the whole bootstrap script.
        raise RuntimeError(f"Worker setup on {vm} failed with exit status {error.returncode}; "
                           "see the message above") from None
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", 0))
        port = sock.getsockname()[1]
    url = f"http://127.0.0.1:{port}"
    tunnel = subprocess.Popen(
        ["boat", "forward", vm, "--bind", "127.0.0.1", "--remote", "3773", "--local", str(port)],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    try:
        for _ in range(60):
            if tunnel.poll() is not None:
                raise RuntimeError("Boat tunnel exited")
            try:
                with urllib.request.urlopen(url, timeout=2):
                    pass
                break
            except urllib.error.HTTPError:
                break  # A running T3 can require authentication.
            except OSError:
                time.sleep(1)
        else:
            raise RuntimeError("T3 worker did not become ready")
        environment = str(uuid.UUID(remote('cat "$HOME/.t3/userdata/environment-id"')))
        cert = json.loads(remote('"$HOME/t3-worker-runtime/node_modules/.bin/t3" auth pairing create --ttl 2m --json'))
        token = next((cert.get(k) for k in ("credential", "pairingCode", "code", "token", "pairingToken")
                      if isinstance(cert.get(k), str)), None)
        if not token or any(c.isspace() for c in token):
            raise RuntimeError("Unrecognized pairing response (values withheld)")
        subprocess.run(["t3", "environment", "link", "--from", "-", "--access", "auto"],
                       input=f"{url} {token}\n", text=True, check=True, stdout=subprocess.DEVNULL)
        print(f"Boat {vm} linked to T3 environment {environment}", flush=True)
    except BaseException:
        if tunnel.poll() is None:
            tunnel.terminate()
        raise


def find_created_by_name(name):
    # Only needed when creation returned without a usable ID (for example, a lost response).
    for delay in (0, 1, 2, 4):
        time.sleep(delay)
        try:
            machines = json.loads(output("boat", "list", "--json"))["sandboxes"]
            ids = [v["id"] for v in machines if v.get("name") == name]
        except (subprocess.CalledProcessError, OSError, ValueError, KeyError):
            continue
        if len(ids) == 1 and re.fullmatch(r"bx_[a-zA-Z0-9]+", ids[0]):
            return ids[0]
        if len(ids) > 1:
            break
    raise RuntimeError(f"Could not resolve the creation outcome. Check Boat for VM named {name}")


def provision(name, environment):
    try:
        result = subprocess.run(
            ["boat", "new", "--json", "--type", "small", "--ttl", "3600", "--no-snapshots",
             "--name", name, "--environment", environment], stdout=subprocess.PIPE, text=True,
        )
    except KeyboardInterrupt:
        vm = find_created_by_name(name)
        subprocess.run(["boat", "delete", "--yes", vm], check=True)
        raise
    vm = None
    for line in result.stdout.splitlines():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if isinstance(event, dict) and event.get("event") in ("created", "ready"):
            identity = event.get("id")
            if isinstance(identity, str) and re.fullmatch(r"bx_[a-zA-Z0-9]+", identity):
                vm = identity
    if vm is None:
        vm = find_created_by_name(name)
    if result.returncode:
        subprocess.run(["boat", "delete", "--yes", vm], check=True)
        raise RuntimeError(f"Boat creation failed; worker {vm} deleted")
    return vm


def delete_check_vm(vm):
    operation_id = None
    deadline = time.monotonic() + 90
    command = ["boat", "delete", "--yes", vm, "--json"]
    while True:
        try:
            result = subprocess.run(command, stdin=subprocess.DEVNULL, capture_output=True,
                                    text=True, check=True, timeout=20)
            operation = json.loads(result.stdout)["operation"]
            identity = operation["id"]
            status = operation["status"]
            if (operation["targetId"] != vm or operation["kind"] != "sandbox"
                    or not isinstance(identity, str) or not re.fullmatch(r"bdop_[a-zA-Z0-9]+", identity)
                    or (operation_id and identity != operation_id)):
                raise ValueError("unexpected deletion operation")
        except (ValueError, TypeError, KeyError) as exc:
            raise RuntimeError(f"Boat returned an unexpected deletion operation for {vm}. Check Boat.") from exc
        except subprocess.SubprocessError as exc:
            if not operation_id:
                raise RuntimeError(f"Deletion of {vm} could not be confirmed. Check Boat.") from exc
            status = "unconfirmed"
        else:
            operation_id = identity
            if status == "completed":
                return
        if status not in ("pending", "processing", "unconfirmed") or time.monotonic() >= deadline:
            raise RuntimeError(f"Deletion of {vm} is {status}. Check: boat deletion status {operation_id}")
        command = ["boat", "deletion", "status", operation_id, "--json"]
        time.sleep(2)


def probe_rows(lead, profile):
    """The row whose model checks each provider's subscription, or None for the provider CLI's default.

    Every worker opens with the lead model, so it checks the lead's provider; a worker also enables the profile's
    other providers, which their CLI default checks.
    """
    return {provider: lead if lead["provider"] == provider else None for provider in PROVIDERS[profile]}


def verify(environment, slug=None):
    profile = os.environ["T3_BOAT_PROFILE"]
    with state_lock():
        lead = read_profile(profile)[0][PARENT]
    if slug and not re.fullmatch(r"[a-zA-Z0-9-]+/[a-zA-Z0-9_.-]+", slug):
        raise ValueError("Expected a GitHub owner/repository")
    vm = provision("t3-check-" + uuid.uuid4().hex[:12], environment)
    print(f"Checking access from Boat VM {vm}", flush=True)

    def check(script, label):
        command = "sh -ec " + shlex.quote(script)
        try:
            subprocess.run(["boat", "ssh", vm, command], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, check=True, timeout=300)
        except (subprocess.CalledProcessError, subprocess.TimeoutExpired):
            raise RuntimeError(f"{label} failed on {vm}. Check Boat environment credentials and model access.") from None
        print(f"[ok] {label}", flush=True)

    try:
        check("gh api 'installation/repositories?per_page=1' >/dev/null 2>&1 || gh api user >/dev/null",
              "GitHub authentication")
        if slug:
            check("GIT_TERMINAL_PROMPT=0 git -c credential.helper= -c 'credential.helper=!gh auth git-credential' "
                  + shlex.join(["ls-remote", "https://github.com/" + slug + ".git", "HEAD"]),
                  f"Git read access to {slug}")
        prompt = "Reply with exactly BOAT_OK. Do not use tools."
        for provider, row in probe_rows(lead, profile).items():
            if provider == "codex":
                args = ["codex", "exec", "--skip-git-repo-check", "--sandbox", "read-only", "--output-last-message", "reply"]
                if row:
                    args.extend(["--model", row["model"], "-c", 'model_reasoning_effort=' + json.dumps(row["effort"])])
                command = shlex.join([*args, prompt])
            else:
                args = ["claude", "-p", "--tools", "", "--output-format", "text"]
                if row:
                    args.extend(["--model", row["model"], "--effort", row["effort"]])
                command = shlex.join([*args, prompt]) + " >reply"
            script = ('export PATH="$HOME/.local/bin:$PATH"; umask 077; mkdir -p "$HOME/t3-worker"; '
                      'cd "$(mktemp -d)"; ' + subscription_check(provider) + "\n" + command
                      + "\ngrep -Fxq BOAT_OK reply")
            label = row["model"] + " / " + row["effort"] if row else "CLI default"
            check(script, f"{provider} subscription reply ({label})")
    finally:
        print(f"Deleting check VM {vm}", flush=True)
        delete_check_vm(vm)
        print(f"[ok] Deleted {vm}", flush=True)


def worker_plan(role=None):
    """What a worker receives: (lead model row, enabled providers, label, instructions).

    Without `role` the worker gets WORKER_NOTE and the lead's brief. With `role`, which must be a role of the
    attached playbook, it gets that role's guide instead. The profile and the package are read together under
    the state lock, so they come from one saved choice even while setup writes a new one.
    """
    home = Path.home()
    with state_lock(home):
        profile = os.environ.get("T3_BOAT_PROFILE") or (home / "profiles/active").read_text().strip()
        state, package, _, _ = read_profile(profile)
        lead = state[PARENT]
        if role is None:
            return lead, PROVIDERS[profile], "a worker", WORKER_NOTE
        if package is None:
            raise ValueError("No playbook is attached, so workers have no roles. Run boat-worker start without a "
                             "role, or attach a playbook with t3-boat setup")
        if role not in package.roles:
            raise ValueError(f"{role!r} is not a role of the attached playbook {package.name}. Its roles: "
                             + ", ".join(package.roles))
        return lead, PROVIDERS[profile], f"the {package.name} {role} role", playbook_skills.worker_guide(package, role)


def start(role=None):
    """Start a worker, optionally for a role of the attached playbook (see worker_plan)."""
    # The state is read once, under its lock; provisioning runs without it, so setup is never kept waiting.
    lead, providers, label, note = worker_plan(role)
    # Only provision from a configured project stub; nothing on the host fetches origin.
    binding = subprocess.run(["git", "config", "--local", "--get", "boat.environment"],
                             text=True, capture_output=True)
    environment = binding.stdout.strip()
    if binding.returncode or not environment or not output("git", "config", "--local", "--get", "remote.origin.url"):
        raise ValueError("Planning is ready in T3. Run t3-boat setup with a GitHub URL to enable coding on Boat.")
    name = "t3-worker-" + uuid.uuid4().hex[:12]
    print(f"Creating Boat worker {name} for {label}", flush=True)
    vm = provision(name, environment)
    print(f"Boat ID: {vm}", flush=True)
    try:
        link(vm, lead, note, providers)
        if role:
            print(f"Installed the {label} guide on {vm}", flush=True)
    except BaseException:
        subprocess.run(["boat", "delete", "--yes", vm], check=True)
        raise


if __name__ == "__main__":
    try:
        if len(sys.argv) in (2, 3) and sys.argv[1] == "start":
            start(*sys.argv[2:])
        elif len(sys.argv) in (3, 4) and sys.argv[1] == "verify":
            verify(*sys.argv[2:])
        else:
            sys.exit("usage: boat-worker start [ROLE] | verify ENVIRONMENT [OWNER/REPO]")
    except (ValueError, OSError, RuntimeError, KeyError, subprocess.CalledProcessError) as exc:
        sys.exit(f"Boat worker: {exc}")
