#!/bin/sh
# Fetch the pinned agent-playbook commit into DIRECTORY. Only an image built with BUNDLE_PLAYBOOK=1 runs this, at
# build time, and setup offers the result as the optional `bundled` playbook; a running installation never fetches
# it on its own. PLAYBOOK_REPOSITORY may name a mirror: the commit ID below still pins every file. Setup downloads
# the same commit (lib/playbook_fetch.py) only when the owner enters `agent-playbook`, and runs no code from it.
set -eu
repository=${PLAYBOOK_REPOSITORY:-https://github.com/pogorelov17/agent-playbook.git}
commit=a27b16a7d6962df7b26fc3233b8503f973f8d715
target=${1:?usage: fetch-playbook DIRECTORY}
if [ "$(cat "$target/.commit" 2>/dev/null)" = "$commit" ]; then
  exit 0
fi
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
git -C "$work" init --quiet
git -C "$work" fetch --quiet --depth 1 "$repository" "$commit"
# A commit ID names its content, so this check pins every file.
test "$(git -C "$work" rev-parse FETCH_HEAD)" = "$commit"
mkdir -p "$work/tree"
git -C "$work" archive FETCH_HEAD | tar -xf - -C "$work/tree"
python3 "$work/tree/scripts/check.py" --root "$work/tree" >&2
printf '%s\n' "$commit" > "$work/tree/.commit"
rm -rf "$target"
mkdir -p "$(dirname "$target")"
mv "$work/tree" "$target"
